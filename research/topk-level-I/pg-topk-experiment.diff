 reversedirection(Tuplesortstate *state)
 {
-	SortSupport sortKey = state->base.sortKeys;
+	SortSupport sortKey;
 	int			nkey;
 
+	/* A variant that orders through comparetup reverses itself. */
+	if (state->base.reversedirection != NULL)
+	{
+		state->base.reversedirection(state);
+		return;
+	}
+
+	sortKey = state->base.sortKeys;
+
 	for (nkey = 0; nkey < state->base.nKeys; nkey++, sortKey++)
 	{
 		sortKey->ssup_reverse = !sortKey->ssup_reverse;
@@ -3500,3 +3520,20 @@ ssup_datum_int32_cmp(Datum x, Datum y, SortSupport ssup)
 	else
 		return 0;
 }
+
+/*
+ * Current cutoff of a bounded sort: the worst tuple among those being kept.
+ *
+ * Returns false when no such value exists -- before the bounded heap is
+ * built, or when the sort declined the bound.  The value is returned by
+ * copy; the root changes on the next put.
+ */
+bool
+tuplesort_get_bounded_root(Tuplesortstate *state, Datum *root)
+{
+	if (state->status != TSS_BOUNDED || state->memtupcount <= 0)
+		return false;
+
+	*root = state->memtuples[0].datum1;
+	return true;
+}
