+/*
+ * Optimistic lower bound on the <=> distance of a candidate.
+ *
+ * Derivation from calc_score_docr().  Per cover:
+ *
+ *     contribution = Cpos / (1 + nNoise) / L^2 / 1.64493406685
+ *     Cpos         = (entries in cover) / InvSum * nitems
+ *
+ * InvSum adds arrdata[wclass] per entry and the smallest entry in `weights`
+ * is 1.0, so Cpos <= nitems.  nNoise >= 0.  L counts covers already seen
+ * with the same key, so within one key group the contributions carry
+ * 1/1, 1/4, 1/9, ... and 1.64493406685 is exactly pi^2/6, the limit of that
+ * series: the whole group sums to at most one maximal contribution.
+ *
+ * So the score is bounded by the number of distinct cover keys times
+ * nitems, and a cover must contain an occurrence of every operand it
+ * covers, so there are at most min_i(npos_i) covers in total.
+ *
+ *     score <= min(ncovers, ndistinct_keys) * nitems
+ *
+ * ndistinct_keys is not known here, so the bound uses the cover count.
+ * DEF_NORM_METHOD is RANK_NO_NORM, so nothing scales the sum afterwards.
+ */
+float8
+rum_ts_distance_lower_bound(Datum *addInfo, bool *addInfoIsNull, int nkeys)
+{
+	return 0.0;				/* replaced by the BM25 bound below */
+}
+
+/*
+ * BM25 candidate bound, optimistic for a distance ordering.
+ *
+ * Per term f(tf) = idf * tf * (k1+1) / (tf + k1) increases in tf, with
+ * supremum idf * (k1+1) as tf grows.  So for the terms known to be present
+ * in this document, before their tf is read,
+ *
+ *     score < SUM_t idf_t * (k1 + 1)
+ *
+ * and the reciprocal is a lower bound on distance.  Only presence is used,
+ * which the merge already established; no tf, no positions, no document
+ * payload.
+ */
+float8
+rum_bm25_distance_lower_bound(bool *entryRes, bool *addInfoIsNull,
+							  double *idf, int nkeys)
+{
+	const double k1 = 1.2;
+	double		score_ub = 0.0;
+	int			i;
+
+	for (i = 0; i < nkeys; i++)
+	{
+		if (!entryRes[i] || addInfoIsNull[i])
+			continue;
+		score_ub += idf[i] * (k1 + 1.0);
+	}
+
+	if (score_ub <= 0.0)
+		return get_float8_infinity();
+	return 1.0 / score_ub;
+}
+
+/* number of positions in an addInfo payload, without decoding them */
+int32
+rum_count_positions(Datum addInfo)
+{
+	bytea	   *positions = DatumGetByteaP(addInfo);
+
+	return count_pos(VARDATA_ANY(positions), VARSIZE_ANY_EXHDR(positions));
+}
