+#if PG_VERSION_NUM >= 160000
+/*
+ * Ordering here is defined by comparetup_rum() alone; there is no
+ * SortSupport to carry a direction.  A bounded sort asks the variant to
+ * reverse itself, so keep the current direction next to the state and
+ * apply it in the comparator.
+ */
+typedef struct RumSortDirection
+{
+	bool		reverse;
+}			RumSortDirection;
+
+static void
+rum_tuplesort_reversedirection(RumTuplesortstate *state)
+{
+	RumSortDirection *dir = (RumSortDirection *) TSS_GET(state)->arg;
+
+	elog(DEBUG1, "rum reversedirection called, dir=%p", (void *) dir);
+	dir->reverse = !dir->reverse;
+}
+
+static inline int
+rum_apply_direction(RumTuplesortstate *state, int res)
+{
+	RumSortDirection *dir = (RumSortDirection *) TSS_GET(state)->arg;
+
+	return (dir != NULL && dir->reverse) ? -res : res;
+}
+#else
+#define rum_apply_direction(state, res)	(res)
+#endif
+
 static int
 comparetup_rum_true(const SortTuple *a, const SortTuple *b,
 					RumTuplesortstate *state)
 {
-	return comparetup_rum(a, b, state, true);
+	return rum_apply_direction(state, comparetup_rum(a, b, state, true));
 }
 
 static int
 comparetup_rum_false(const SortTuple *a, const SortTuple *b,
 					 RumTuplesortstate *state)
 {
-	return comparetup_rum(a, b, state, false);
+	return rum_apply_direction(state, comparetup_rum(a, b, state, false));
 }
 
