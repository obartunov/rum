+
+/*
+ * Ask for at most `bound` tuples.  Must be called before any tuple is put.
+ * The sort may still decline to use a bounded heap -- see
+ * optimize_bounded_sort and the size checks in tuplesort_set_bound -- in
+ * which case rum_tuplesort_get_cutoff() keeps reporting false.
+ */
+void
+rum_tuplesort_set_bound(RumTuplesortstate *state, int64 bound)
+{
+#if PG_VERSION_NUM >= 150000
+	elog(DEBUG1, "rum sort state before set_bound: nKeys=%d sortKeys=%p comparetup=%p",
+		 TSS_GET(state)->nKeys, (void *) TSS_GET(state)->sortKeys,
+		 (void *) TSS_GET(state)->comparetup);
+	tuplesort_set_bound(state, bound);
+	elog(DEBUG1, "set_bound returned");
+#endif
+}
+
+/*
+ * Current top-K cutoff: the worst ordering value among the tuples the
+ * bounded heap is keeping, by value.
+ *
+ * Returns false while no cutoff exists -- before the heap is built, or if
+ * the sort declined the bound.  A caller that gets false must do the full
+ * work; there is no cutoff to prune against.
+ *
+ * The value is copied out deliberately.  The heap root changes on the next
+ * put, so the caller must not hold a reference into the sort state.
+ */
+bool
+rum_tuplesort_get_cutoff(RumTuplesortstate *state, float8 *cutoff)
+{
+#if PG_VERSION_NUM >= 150000
+	Datum		root;
+
+	if (!tuplesort_get_bounded_root(state, &root))
+		return false;
+
+	*cutoff = DatumGetFloat8(root);
+	return true;
+#else
+	return false;
+#endif
+}
